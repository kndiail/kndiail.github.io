<footer id="footer">
    <div id="footer-wrap">
        <div>
            &copy; <%= date(Date.now(), "YYYY") %> 由
            <a href="https://github.com/kndiail">Kndiail</a>
            用心制作
        </div>
        <div>
            Powered by <a href="https://hexo.io">Hexo</a>
        </div>
        <div class="site-stats">
            总访问 <span id="busuanzi_value_site_pv"></span> ·
            总访客 <span id="busuanzi_value_site_uv"></span>
        </div>
        <% if (theme.footer.ICP.enable) { %>
        <div>
            <% if (theme.footer.ICP.link) { %>
            <a href="<%- url_for(theme.footer.ICP.link) %>"><%= theme.footer.ICP.code %></a>
            <% } else { %>
            <%= theme.footer.ICP.code %>
            <% } %>
        </div>
        <% } %>
    </div>
</footer>
